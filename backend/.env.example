# Copy this file to `backend/.env` for local development. `.env` is
# gitignored and its contents -- the Gemini key above all -- must never be
# logged or committed.

# Required to call Gemini for embeddings and streamed answers. Leave unset
# and set GEMINI_OFFLINE_STUB=true to run ingestion and chat against a
# deterministic offline stub instead (what the test suite does).
GEMINI_API_KEY=
GEMINI_OFFLINE_STUB=false

ANSWER_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=models/text-embedding-004

# Cosine-similarity floor a retrieved passage must clear before it is used;
# also editable by an admin at runtime via /api/admin/settings.
SIMILARITY_THRESHOLD=0.62
SIGNUP_ENABLED=true
FALLBACK_ENABLED=true

# Off for local http; set to true once the app is served over https.
SESSION_COOKIE_SECURE=false

# SQLite locally; point at Postgres + pgvector (with the `vector` extension
# installed) in any shared environment.
DATABASE_URL=sqlite:///./app.db

# Where uploaded originals are kept on this machine's disk.
FILE_STORE_DIR=./uploads

# Comma-separated list of origins the frontend is served from.
ALLOWED_ORIGINS=http://localhost:5173
